rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isOwner(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function validBookingCreate(businessId) {
      return request.resource.data.businessId == businessId
        && request.resource.data.referenceNo is string
        && request.resource.data.referenceNo.size() == 5
        && request.resource.data.serviceId is string
        && request.resource.data.serviceName is string
        && request.resource.data.serviceDurationMinutes is int
        && request.resource.data.servicePrice is number
        && request.resource.data.specialistId is string
        && request.resource.data.specialistName is string
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.status == 'pending'
        && request.resource.data.whatsappOptIn is bool
        && request.resource.data.slotId is string
        && request.resource.data.createdAt == request.time;
    }

    function validSlotCreate(businessId, slotId) {
      return request.resource.data.slotId == slotId
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.specialistId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    match /superadmins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if true;
      allow list: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (isOwner(businessId)
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isSuperAdmin() || isOwner(businessId);
      allow create: if isSuperAdmin()
        || (signedIn() && request.resource.data.ownerId == request.auth.uid);

      match /services/{serviceId} {
        allow get, list: if true;
        allow create, update, delete: if isSuperAdmin() || isOwner(businessId);
      }

      match /specialists/{specialistId} {
        allow get, list: if true;
        allow create, update, delete: if isSuperAdmin() || isOwner(businessId);
      }

      match /hours/{dayId} {
        allow get, list: if true;
        allow create, update, delete: if isSuperAdmin() || isOwner(businessId);
      }

      match /bookings/{bookingId} {
        allow create: if validBookingCreate(businessId);
        allow get, list: if isSuperAdmin() || isOwner(businessId);
        allow update, delete: if isSuperAdmin() || isOwner(businessId);
      }

      match /slots/{slotId} {
        allow create: if validSlotCreate(businessId, slotId)
          && !exists(/databases/$(database)/documents/businesses/$(businessId)/slots/$(slotId));
        allow get: if true;
        allow list: if false;
        allow update, delete: if isSuperAdmin() || isOwner(businessId);
      }
    }
  }
}
